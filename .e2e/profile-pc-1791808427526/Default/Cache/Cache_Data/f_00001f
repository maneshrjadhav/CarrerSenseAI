 0.3s ease;\n}\n\n.cs-feature-card:hover .card-hover-halo {\n  opacity: 1;\n}\n\n.feature-micro-preview-box.preview-glow {\n  background: #f0fdfa;\n  border-color: rgba(8, 145, 178, 0.3);\n}\n\n.feature-micro-preview-box.preview-glow .preview-code-tag {\n  color: var(--teal);\n}\n\n/* 14. Responsive Layout Adaptations for All New Sections */\n@media (max-width: 1024px) {\n  .semantic-graph-stage {\n    grid-template-columns: 1fr;\n    gap: 20px;\n  }\n  .graph-stream-arrow {\n    transform: rotate(90deg);\n    margin: -10px auto;\n  }\n  .resume-scan-dual-grid {\n    grid-template-columns: 1fr;\n  }\n  .storytelling-row,\n  .storytelling-row.row-reversed {\n    grid-template-columns: 1fr;\n    gap: 24px;\n  }\n  .storytelling-row.row-reversed .storytelling-graphic-col {\n    order: 1;\n  }\n  .storytelling-row.row-reversed .storytelling-content-col {\n    order: 2;\n  }\n  .skill-gap-comparison-grid {\n    grid-template-columns: 1fr;\n  }\n  .vector-viz-stage-grid {\n    grid-template-columns: 1fr;\n  }\n  .demo-ai-insights-strip {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 768px) {\n  .career-intel-bg-img {\n    opacity: 0.08;\n  }\n  .hero-master-container {\n    padding: 95px 20px 48px;\n    min-height: auto;\n  }\n  .hero-headline-h1 {\n    font-size: 2.4rem;\n  }\n  .hero-kicker-lead {\n    font-size: 1rem;\n  }\n  .hero-lead-description {\n    font-size: 0.95rem;\n  }\n  .timeline-connecting-track {\n    display: none;\n  }\n  .hero-cta-buttons-row {\n    flex-direction: column;\n    width: 100%;\n  }\n  .hero-primary-btn,\n  .hero-secondary-btn {\n    width: 100%;\n  }\n}\n\n@media (max-width: 480px) {\n  .career-intel-bg-img {\n    opacity: 0.06;\n  }\n  .hero-master-container {\n    padding: 85px 16px 40px;\n  }\n  .hero-headline-h1 {\n    font-size: 2rem;\n  }\n  .demo-ai-insights-strip {\n    grid-template-columns: 1fr;\n  }\n  .roadmap-nodes-timeline {\n    grid-template-columns: repeat(7, 240px);\n  }\n  .console-stage-row {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 8px;\n  }\n}\n\n/* Master Zero Horizontal Overflow Guard */\nhtml, body, .landing-master-wrapper {\n  overflow-x: hidden;\n  max-width: 100vw;\n}\n\n/* ==========================================================================\n   CAREERSENSE AI — STEP 4: PRODUCTION CANDIDATE DASHBOARD STYLES\n   ========================================================================== */\n\n.dashboard-content-wrapper {\n  position: relative;\n  min-height: calc(100vh - 72px);\n  padding: 24px;\n}\n\n/* Subtle Technical AI Data Grid Pattern */\n.dashboard-technical-bg {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  pointer-events: none;\n  z-index: 0;\n  background-image: \n    radial-gradient(circle at 10% 20%, rgba(37, 99, 235, 0.03) 0%, transparent 40%),\n    radial-gradient(circle at 90% 80%, rgba(16, 185, 129, 0.02) 0%, transparent 40%),\n    linear-gradient(to right, rgba(255, 255, 255, 0.015) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(255, 255, 255, 0.015) 1px, transparent 1px);\n  background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;\n  opacity: 0.8;\n}\n\n.dashboard-container-inner {\n  position: relative;\n  z-index: 1;\n  max-width: 1360px;\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  gap: 22px;\n}\n\n/* Welcome Banner */\n.dashboard-welcome-banner {\n  background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.85) 100%);\n  border: 1px solid rgba(59, 130, 246, 0.18);\n  border-radius: var(--radius-lg, 14px);\n  padding: 26px 30px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 20px;\n  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);\n  backdrop-filter: blur(12px);\n}\n\n.welcome-tag {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  background: rgba(37, 99, 235, 0.15);\n  border: 1px solid rgba(37, 99, 235, 0.3);\n  padding: 4px 10px;\n  border-radius: 20px;\n  font-size: 0.72rem;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  color: #60a5fa;\n  margin-bottom: 8px;\n}\n\n.welcome-heading {\n  font-size: 1.75rem;\n  font-weight: 800;\n  color: var(--text-main, #f8fafc);\n  margin: 0 0 4px 0;\n  letter-spacing: -0.02em;\n}\n\n.welcome-subtitle {\n  color: var(--text-muted, #94a3b8);\n  font-size: 0.95rem;\n  margin: 0;\n}\n\n.welcome-actions-col {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-shrink: 0;\n}\n\n.secondary-btn-subtle {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 18px;\n  border-radius: var(--radius-md, 8px);\n  background: rgba(255, 255, 255, 0.04);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: var(--text-main, #f1f5f9);\n  font-size: 0.875rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.secondary-btn-subtle:hover {\n  background: rgba(255, 255, 255, 0.08);\n  border-color: rgba(255, 255, 255, 0.22);\n}\n\n/* Grids Layout */\n.dashboard-grid-dual {\n  display: grid;\n  grid-template-columns: 1.15fr 0.85fr;\n  gap: 20px;\n}\n\n.dashboard-grid-triple {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 20px;\n}\n\n.dashboard-grid-split {\n  display: grid;\n  grid-template-columns: 1.35fr 0.95fr;\n  gap: 20px;\n}\n\n.dashboard-section-full {\n  width: 100%;\n}\n\n/* Reusable Dashboard Card */\n.dashboard-card {\n  background: rgba(15, 23, 42, 0.65);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: var(--radius-lg, 14px);\n  padding: 22px 24px;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);\n  backdrop-filter: blur(10px);\n  transition: border-color 0.2s ease, transform 0.2s ease;\n}\n\n.dashboard-card:hover {\n  border-color: rgba(59, 130, 246, 0.3);\n}\n\n.card-header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 18px;\n}\n\n.card-badge {\n  font-size: 0.68rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: #38bdf8;\n  display: block;\n  margin-bottom: 3px;\n  text-transform: uppercase;\n}\n\n.card-title {\n  font-size: 1.15rem;\n  font-weight: 750;\n  color: var(--text-main, #f8fafc);\n  margin: 0;\n  letter-spacing: -0.01em;\n}\n\n.card-bottom-action {\n  margin-top: auto;\n  padding-top: 18px;\n  border-top: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n.text-action-btn {\n  background: transparent;\n  border: none;\n  color: #38bdf8;\n  font-size: 0.85rem;\n  font-weight: 600;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  cursor: pointer;\n  padding: 0;\n  transition: gap 0.2s ease, color 0.2s ease;\n}\n\n.text-action-btn:hover {\n  color: #60a5fa;\n  gap: 10px;\n}\n\n/* Status Pills */\n.status-pill {\n  padding: 3px 10px;\n  border-radius: 12px;\n  font-size: 0.75rem;\n  font-weight: 600;\n}\n\n.status-pill-neutral {\n  background: rgba(148, 163, 184, 0.1);\n  border: 1px solid rgba(148, 163, 184, 0.25);\n  color: #94a3b8;\n}\n\n.count-pill {\n  background: rgba(37, 99, 235, 0.12);\n  border: 1px solid rgba(37, 99, 235, 0.25);\n  color: #93c5fd;\n  padding: 3px 10px;\n  border-radius: 12px;\n  font-size: 0.75rem;\n  font-weight: 600;\n}\n\n/* Profile Summary Card */\n.completion-ring-wrap {\n  text-align: right;\n}\n\n.completion-score {\n  font-size: 1.5rem;\n  font-weight: 850;\n  color: #10b981;\n  line-height: 1;\n}\n\n.completion-label {\n  font-size: 0.72rem;\n  color: #94a3b8;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n.profile-details-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 14px 18px;\n  margin-bottom: 8px;\n}\n\n.profile-detail-item {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.detail-label-icon {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 0.75rem;\n  color: #94a3b8;\n}\n\n.detail-value {\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: #f1f5f9;\n}\n\n.status-tag-muted {\n  color: #f59e0b;\n}\n\n/* Career Readiness Card */\n.readiness-gauge-body {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n  padding: 12px 0;\n}\n\n.gauge-circle-outer {\n  width: 96px;\n  height: 96px;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.03);\n  border: 2px dashed rgba(255, 255, 255, 0.15);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.gauge-circle-inner {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n\n.gauge-score-value {\n  font-size: 1.35rem;\n  font-weight: 850;\n  color: #f8fafc;\n  line-height: 1;\n}\n\n.gauge-score-caption {\n  font-size: 0.65rem;\n  color: #94a3b8;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  margin-top: 2px;\n}\n\n.readiness-copy {\n  font-size: 0.925rem;\n  color: #f1f5f9;\n  font-weight: 550;\n  margin: 0 0 6px 0;\n  line-height: 1.4;\n}\n\n.readiness-subtext {\n  font-size: 0.78rem;\n  color: #94a3b8;\n  line-height: 1.4;\n  display: block;\n}\n\n/* Resume Intelligence Card */\n.pipeline-state-badge {\n  background: rgba(16, 185, 129, 0.1);\n  border: 1px solid rgba(16, 185, 129, 0.3);\n  color: #34d399;\n  padding: 3px 10px;\n  border-radius: 12px;\n  font-size: 0.75rem;\n  font-weight: 600;\n}\n\n.resume-empty-callout {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  padding: 18px 20px;\n  background: rgba(37, 99, 235, 0.05);\n  border: 1px solid rgba(37, 99, 235, 0.18);\n  border-radius: 10px;\n  margin-bottom: 20px;\n}\n\n.empty-callout-icon {\n  width: 48px;\n  height: 48px;\n  border-radius: 10px;\n  background: rgba(37, 99, 235, 0.12);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.empty-callout-text h3 {\n  margin: 0 0 4px 0;\n  font-size: 1rem;\n  font-weight: 700;\n  color: #f8fafc;\n}\n\n.empty-callout-text p {\n  margin: 0;\n  font-size: 0.85rem;\n  color: #94a3b8;\n  line-height: 1.4;\n}\n\n.resume-active-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 14px 18px;\n  background: rgba(16, 185, 129, 0.06);\n  border: 1px solid rgba(16, 185, 129, 0.2);\n  border-radius: 10px;\n  margin-bottom: 20px;\n}\n\n.resume-file-info {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.resume-file-info strong {\n  display: block;\n  font-size: 0.95rem;\n  color: #f8fafc;\n}\n\n.resume-file-info span {\n  font-size: 0.75rem;\n  color: #34d399;\n}\n\n.pipeline-architecture-block {\n  background: rgba(255, 255, 255, 0.02);\n  border: 1px solid rgba(255, 255, 255, 0.05);\n  border-radius: 10px;\n  padding: 16px 18px;\n}\n\n.pipeline-block-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.72rem;\n  font-weight: 700;\n  color: #94a3b8;\n  letter-spacing: 0.06em;\n  margin-bottom: 14px;\n}\n\n.pipeline-notice {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  color: #38bdf8;\n}\n\n.pipeline-nodes-track {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  overflow-x: auto;\n  padding-bottom: 4px;\n}\n\n.pipeline-node-card {\n  flex: 1;\n  min-width: 125px;\n  background: rgba(15, 23, 42, 0.8);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 8px;\n  padding: 12px 10px;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n}\n\n.pipeline-node-icon {\n  width: 30px;\n  height: 30px;\n  border-radius: 6px;\n  background: rgba(37, 99, 235, 0.12);\n  color: #60a5fa;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 2px;\n}\n\n.pipeline-node-title {\n  font-size: 0.8rem;\n  color: #f1f5f9;\n  font-weight: 650;\n}\n\n.pipeline-node-desc {\n  font-size: 0.68rem;\n  color: #94a3b8;\n}\n\n.pipeline-track-connector {\n  color: rgba(255, 255, 255, 0.2);\n  font-size: 1rem;\n  user-select: none;\n}\n\n/* Dark dashboard variants (must follow the light page definitions above) */\n.pipeline-node-card.active {\n  background: rgba(37, 99, 235, 0.12);\n  border-color: rgba(59, 130, 246, 0.45);\n  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.2);\n}\n\n.pipeline-node-card.completed {\n  background: rgba(15, 23, 42, 0.8);\n  border-color: rgba(16, 185, 129, 0.3);\n}\n\n.pipeline-node-card.completed .pipeline-node-icon {\n  background: rgba(16, 185, 129, 0.15);\n  color: #34d399;\n}\n\n.pipeline-node-card.active .pipeline-node-icon {\n  background: rgba(37, 99, 235, 0.2);\n  color: #93c5fd;\n}\n\n/* Quick Actions Section */\n.dashboard-quick-actions-section {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n\n.section-title-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n}\n\n.section-title {\n  font-size: 1.25rem;\n  font-weight: 750;\n  color: var(--text-main, #f8fafc);\n  margin: 0;\n  letter-spacing: -0.01em;\n}\n\n.section-subtext {\n  font-size: 0.82rem;\n  color: #94a3b8;\n}\n\n.quick-actions-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 16px;\n}\n\n.quick-action-card {\n  background: rgba(15, 23, 42, 0.65);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: var(--radius-md, 10px);\n  padding: 18px;\n  cursor: pointer;\n  display: flex;\n  flex-direction: column;\n  transition: all 0.2s ease;\n  backdrop-filter: blur(8px);\n}\n\n.quick-action-card:hover {\n  transform: translateY(-3px);\n  border-color: rgba(59, 130, 246, 0.4);\n  box-shadow: 0 8px 24px rgba(37, 99, 235, 0.12);\n}\n\n.qa-top-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 12px;\n}\n\n.qa-icon-wrap {\n  width: 38px;\n  height: 38px;\n  border-radius: 8px;\n  background: rgba(37, 99, 235, 0.12);\n  color: #60a5fa;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.qa-badge {\n  font-size: 0.65rem;\n  font-weight: 700;\n  padding: 2px 8px;\n  border-radius: 10px;\n  background: rgba(255, 255, 255, 0.05);\n  color: #94a3b8;\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.qa-card-title {\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: #f8fafc;\n  margin: 0 0 6px 0;\n}\n\n.qa-card-desc {\n  font-size: 0.78rem;\n  color: #94a3b8;\n  margin: 0 0 16px 0;\n  line-height: 1.45;\n}\n\n.qa-bottom-row {\n  margin-top: auto;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  color: #38bdf8;\n  font-size: 0.78rem;\n  font-weight: 600;\n}\n\n.qa-arrow-icon {\n  transition: transform 0.2s ease;\n}\n\n.quick-action-card:hover .qa-arrow-icon {\n  transform: translateX(3px);\n}\n\n/* Skill Intelligence Card */\n.skills-empty-state {\n  text-align: center;\n  padding: 10px 4px;\n}\n\n.skill-source-label {\n  font-size: 0.78rem;\n  font-weight: 600;\n  color: #94a3b8;\n  margin: 0 0 8px 0;\n}\n\n.empty-icon-halo {\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  background: rgba(37, 99, 235, 0.1);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: 0 auto 10px;\n}\n\n.empty-state-title {\n  font-size: 1rem;\n  font-weight: 700;\n  color: #f8fafc;\n  margin: 0 0 6px 0;\n}\n\n.empty-state-desc {\n  font-size: 0.8rem;\n  color: #94a3b8;\n  line-height: 1.45;\n  margin: 0 0 16px 0;\n}\n\n.planned-categories-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 8px;\n  text-align: left;\n}\n\n.planned-category-pill {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 12px;\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.02);\n  border: 1px solid rgba(255, 255, 255, 0.05);\n  font-size: 0.78rem;\n}\n\n.planned-category-pill .cat-icon {\n  color: #60a5fa;\n  flex-shrink: 0;\n}\n\n.planned-category-pill .cat-title {\n  color: #f1f5f9;\n  font-weight: 550;\n  flex-grow: 1;\n}\n\n.planned-category-pill .cat-empty-tag {\n  color: #64748b;\n  font-size: 0.7rem;\n}\n\n/* Skill Gap Card */\n.gap-summary-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-bottom: 12px;\n}\n\n.gap-stat-chip {\n  font-size: 0.72rem;\n  font-weight: 700;\n  padding: 3px 9px;\n  border-radius: 999px;\n  border: 1px solid transparent;\n}\n\n.gap-stat-matched {\n  background: rgba(16, 185, 129, 0.12);\n  border-color: rgba(16, 185, 129, 0.3);\n  color: #34d399;\n}\n\n.gap-stat-partial {\n  background: rgba(245, 158, 11, 0.12);\n  border-color: rgba(245, 158, 11, 0.3);\n  color: #fbbf24;\n}\n\n.gap-stat-missing {\n  background: rgba(244, 63, 94, 0.12);\n  border-color: rgba(244, 63, 94, 0.3);\n  color: #fb7185;\n}\n\n.gap-wireframe-placeholder {\n  height: 110px;\n  position: relative;\n  background: rgba(255, 255, 255, 0.02);\n  border: 1px dashed rgba(255, 255, 255, 0.1);\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 14px;\n}\n\n.wireframe-radar-ring {\n  position: absolute;\n  border-radius: 50%;\n  border: 1px solid rgba(59, 130, 246, 0.15);\n}\n\n.wireframe-radar-ring.outer { width: 90px; height: 90px; }\n.wireframe-radar-ring.mid { width: 60px; height: 60px; }\n.wireframe-radar-ring.inner { width: 30px; height: 30px; }\n\n.wireframe-radar-label {\n  position: relative;\n  z-index: 1;\n  font-size: 0.75rem;\n  color: #94a3b8;\n  font-weight: 500;\n}\n\n.gap-prompt-text {\n  font-size: 0.88rem;\n  font-weight: 600;\n  color: #f8fafc;\n  margin: 0 0 4px 0;\n  line-height: 1.4;\n}\n\n.gap-subtext {\n  font-size: 0.78rem;\n  color: #94a3b8;\n  line-height: 1.4;\n  display: block;\n}\n\n/* Job Match Card */\n.pillars-flow-preview {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-bottom: 16px;\n}\n\n.pillar-metric-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 4px 8px;\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.03);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  font-size: 0.72rem;\n  color: #cbd5e1;\n}\n\n.pillar-metric-chip .pillar-icon {\n  color: #38bdf8;\n}\n\n.job-match-empty-notice {\n  text-align: center;\n  padding: 8px 0;\n}\n\n/* Career Roadmap Card */\n.roadmap-summary-stats {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px 14px;\n  margin-bottom: 8px;\n}\n\n.roadmap-stat {\n  font-size: 0.75rem;\n  font-weight: 600;\n  color: #94a3b8;\n}\n\n.roadmap-next-task {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  padding: 8px 10px;\n  border-radius: 6px;\n  background: rgba(56, 189, 248, 0.08);\n  border: 1px solid rgba(56, 189, 248, 0.2);\n  margin-bottom: 4px;\n}\n\n.next-task-label {\n  font-size: 0.68rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: #38bdf8;\n  flex-shrink: 0;\n}\n\n.next-task-title {\n  font-size: 0.78rem;\n  color: #e2e8f0;\n  line-height: 1.35;\n}\n\n.roadmap-lead-text {\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: #f8fafc;\n  margin: 0 0 16px 0;\n}\n\n.roadmap-timeline-track {\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  gap: 8px;\n  margin-bottom: 14px;\n}\n\n.roadmap-step-node {\n  background: rgba(255, 255, 255, 0.02);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  border-radius: 8px;\n  padding: 12px 6px;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n}\n\n.step-node-bubble {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background: rgba(37, 99, 235, 0.1);\n  color: #60a5fa;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 4px;\n}\n\n.step-node-label {\n  font-size: 0.75rem;\n  color: #f1f5f9;\n  font-weight: 600;\n}\n\n.step-node-stage {\n  font-size: 0.65rem;\n  color: #94a3b8;\n  text-transform: uppercase;\n}\n\n.roadmap-subtext-note {\n  font-size: 0.75rem;\n  color: #94a3b8;\n  line-height: 1.4;\n  display: block;\n}\n\n/* Recent Activity Card */\n.activity-empty-state {\n  text-align: center;\n  padding: 10px 0;\n}\n\n.future-activity-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  justify-content: center;\n}\n\n.future-tag {\n  font-size: 0.7rem;\n  color: #64748b;\n  background: rgba(255, 255, 255, 0.02);\n  border: 1px solid rgba(255, 255, 255, 0.05);\n  padding: 3px 8px;\n  border-radius: 4px;\n}\n\n/* Activity Log List (Recent Activity card) */\n.activity-list-real {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.activity-item-row {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  padding: 10px 0;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n}\n\n.activity-item-row:first-child {\n  padding-top: 0;\n}\n\n.activity-item-row:last-child {\n  border-bottom: none;\n  padding-bottom: 0;\n}\n\n.activity-icon-wrap {\n  width: 28px;\n  height: 28px;\n  border-radius: 8px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  background: rgba(37, 99, 235, 0.12);\n  color: #60a5fa;\n}\n\n.activity-type-payment { background: rgba(16, 185, 129, 0.12); color: #34d399; }\n.activity-type-interview { background: rgba(124, 58, 237, 0.12); color: #a78bfa; }\n.activity-type-roadmap { background: rgba(8, 145, 178, 0.12); color: #38bdf8; }\n.activity-type-upload { background: rgba(217, 119, 6, 0.12); color: #fbbf24; }\n\n.activity-text-col {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.activity-title {\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: #f1f5f9;\n  line-height: 1.35;\n  overflow-wrap: anywhere;\n}\n\n.activity-desc {\n  font-size: 0.75rem;\n  color: #94a3b8;\n  line-height: 1.4;\n  overflow-wrap: anywhere;\n}\n\n.activity-time {\n  font-size: 0.7rem;\n  color: #94a3b8;\n  white-space: nowrap;\n  flex-shrink: 0;\n  padding-top: 2px;\n}\n\n.activity-empty-icon {\n  color: #64748b;\n}\n\n/* Status Pill variants used on dark dashboard cards\n   (previously referenced by components but never defined) */\n.status-pill-emerald {\n  background: rgba(16, 185, 129, 0.12);\n  border: 1px solid rgba(16, 185, 129, 0.3);\n  color: #34d399;\n}\n\n.status-pill-blue {\n  background: rgba(37, 99, 235, 0.12);\n  border: 1px solid rgba(37, 99, 235, 0.3);\n  color: #60a5fa;\n}\n\n.status-pill-rose {\n  background: rgba(244, 63, 94, 0.12);\n  border: 1px solid rgba(244, 63, 94, 0.3);\n  color: #fb7185;\n}\n\n.status-pill-amber {\n  background: rgba(245, 158, 11, 0.12);\n  border: 1px solid rgba(245, 158, 11, 0.3);\n  color: #fbbf24;\n}\n\n/* Module Shell / Coming Soon Page */\n.module-shell-page {\n  padding: 40px 20px;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: calc(100vh - 120px);\n}\n\n.module-shell-card {\n  max-width: 560px;\n  width: 100%;\n  background: rgba(15, 23, 42, 0.7);\n  border: 1px solid rgba(59, 130, 246, 0.25);\n  border-radius: 16px;\n  padding: 36px 30px;\n  text-align: center;\n  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);\n  backdrop-filter: blur(14px);\n}\n\n.module-shell-icon-box {\n  width: 64px;\n  height: 64px;\n  border-radius: 50%;\n  background: rgba(37, 99, 235, 0.12);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: 0 auto 18px;\n}\n\n.module-shell-title {\n  font-size: 1.5rem;\n  font-weight: 750;\n  color: #f8fafc;\n  margin: 0 0 8px 0;\n}\n\n.module-shell-subtitle {\n  font-size: 0.925rem;\n  color: #94a3b8;\n  line-height: 1.5;\n  margin: 0 0 16px 0;\n}\n\n.module-shell-badge {\n  display: inline-block;\n  padding: 4px 12px;\n  border-radius: 20px;\n  background: rgba(16, 185, 129, 0.12);\n  border: 1px solid rgba(16, 185, 129, 0.3);\n  color: #34d399;\n  font-size: 0.75rem;\n  font-weight: 600;\n}\n\n/* Responsive Rules for Dashboard */\n@media (max-width: 1200px) {\n  .dashboard-grid-triple {\n    grid-template-columns: 1fr;\n  }\n  .roadmap-timeline-track {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n@media (max-width: 992px) {\n  .dashboard-grid-dual,\n  .dashboard-grid-split {\n    grid-template-columns: 1fr;\n  }\n  .dashboard-welcome-banner {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n  .welcome-actions-col {\n    width: 100%;\n    flex-wrap: wrap;\n  }\n}\n\n@media (max-width: 640px) {\n  .profile-details-grid {\n    grid-template-columns: 1fr;\n  }\n  .roadmap-timeline-track {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .dashboard-content-wrapper {\n    padding: 16px;\n  }\n}\n\n/* ==========================================================================\n   RESUME INTELLIGENCE & ANALYSIS REPORT SYSTEM STYLES\n   ========================================================================== */\n\n.analysis-report-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  flex-wrap: wrap;\n  gap: 16px;\n  padding-bottom: 8px;\n}\n\n.report-main-title {\n  font-size: 1.85rem;\n  font-weight: 850;\n  color: var(--text-main);\n  letter-spacing: -0.02em;\n}\n\n.report-meta-strip {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 16px;\n}\n\n.meta-strip-item {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 0.825rem;\n  color: var(--text-sub);\n  font-weight: 500;\n}\n\n/* Match Score Hero Card */\n.match-score-hero-card {\n  padding: 28px !important;\n  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);\n  border: 1px solid rgba(2, 132, 199, 0.2) !important;\n  box-shadow: 0 10px 30px rgba(2, 132, 199, 0.06);\n}\n\n.score-hero-layout {\n  display: grid;\n  grid-template-columns: 240px 1fr;\n  gap: 32px;\n  align-items: center;\n}\n\n.score-circular-wrapper {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n\n.score-radial-meter {\n  position: relative;\n  width: 170px;\n  height: 170px;\n}\n\n.radial-svg {\n  width: 100%;\n  height: 100%;\n  transform: rotate(-90deg);\n}\n\n.radial-bg {\n  fill: none;\n  stroke: #e2e8f0;\n  stroke-width: 10;\n}\n\n.radial-progress {\n  fill: none;\n  stroke: var(--primary);\n  stroke