chunks.","solution":"const { Transform } = require('stream');\n\nclass LineNumberer extends Transform {\n  constructor(options) {\n    super(options);\n    this.lineNumber = 1;\n  }\n  _transform(chunk, encoding, callback) {\n    const lines = chunk.toString().split('\\n');\n    const numbered = lines.map(line => `${this.lineNumber++}: ${line}`).join('\\n');\n    this.push(numbered);\n    callback();\n  }\n}","starter_code":"const { Transform } = require('stream');\n\nclass LineNumberer extends Transform {\n  constructor(options) {\n    super(options);\n    this.lineNumber = 1;\n  }\n  _transform(chunk, encoding, callback) {\n    // TODO: Split chunk into lines and prepend line numbers\n    callback();\n  }\n}","title":"Exercise 1: Transform Stream Line Counter"},{"scenario":"Write a higher-order function retryAsync(fn, maxRetries, delayMs) that retries a rejected promise with exponential backoff.","solution":"async function retryAsync(asyncFn, retries = 3, delay = 500) {\n  let attempt = 0;\n  while (attempt < retries) {\n    try {\n      return await asyncFn();\n    } catch (err) {\n      attempt++;\n      if (attempt >= retries) throw err;\n      await new Promise(r => setTimeout(r, delay * Math.pow(2, attempt - 1)));\n    }\n  }\n}","starter_code":"async function retryAsync(asyncFn, retries = 3, delay = 500) {\n  // TODO: implement retry loop with exponential delay\n}","title":"Exercise 2: Resilient Asynchronous Retry Wrapper"}],"objectives":["Understand the V8 JavaScript engine and non-blocking event loop phases (timers, I/O polling, check, close).","Utilize core Node.js modules (fs, path, events, http, stream) for high-throughput server-side I/O.","Implement asynchronous patterns using Promises, async/await, and EventEmitter safely with zero unhandled rejections.","Structure and package production applications with modern ES modules, npm dependencies, and clustering."],"outcome":"Mastery of server-side JavaScript programming, event-driven architecture, and scalable microservice design.","project":"High-Throughput Streaming File Transformer Microservice with Worker Clustering & Graceful Shutdown","quiz":[{"correct_index":1,"explanation":"process.nextTick() is not technically part of the event loop phases; the nextTickQueue is processed immediately after the current operation finishes, resolving before microtasks and before any event loop phase transitions.","id":1,"options":["The Timers phase alongside setTimeout callbacks","Immediately after the current operation finishes, before entering the next phase of the event loop","The I/O Poll phase after libuv completes network sockets","The Close Callbacks phase at the very end of the cycle"],"question":"Which phase of the Node.js event loop executes callbacks scheduled by process.nextTick()?"},{"correct_index":1,"explanation":"If an error occurs midway through readable.pipe(writable), the destination stream remains open and can cause memory/file descriptor leaks. stream.pipeline() forwards errors and cleanly closes all stream descriptors.","id":2,"options":["pipeline() runs on worker threads for 4x higher performance","pipeline() properly cleans up stream resources and automatically handles errors, while .pipe() does not forward errors to the destination","pipeline() compresses all data with GZIP automatically","readable.pipe() has been deprecated and removed in modern Node.js versions"],"question":"Why is stream.pipeline() preferred over readable.pipe(writable) in production applications?"},{"correct_index":1,"explanation":"setImmediate() runs in the Check phase of the event loop (directly following the I/O Poll phase). When called within an I/O callback, setImmediate() is guaranteed to execute before any timer callback scheduled in the same turn.","id":3,"options":["setTimeout(0) always executes before setImmediate() under all circumstances","setImmediate() is designed to run in the Check phase after the Poll phase, whereas setTimeout(0) runs in the Timers phase","setImmediate() blocks the event loop until worker threads finish","setTimeout(0) is only supported in web browsers, not Node.js"],"question":"What is the primary difference between setImmediate() and setTimeout(fn, 0)?"},{"correct_index":1,"explanation":"Because Node.js executes JavaScript on a single thread, clustering forks multiple child processes that share the same listening socket, distributing incoming TCP connections across all available CPU cores.","id":4,"options":["Wrapping all route handlers with async/await","The cluster module or process managers like PM2 to fork multiple worker processes sharing a single port","Increasing the libuv thread pool size via UV_THREADPOOL_SIZE=128","Using setInterval with 0 delay"],"question":"Which Node.js mechanism should you use to utilize all available CPU cores for a web server?"},{"correct_index":2,"explanation":"Modern Node.js versions terminate the process with an exit status code of 1 on unhandled promise rejections, preventing applications from running in an inconsistent or zombie state.","id":5,"options":["Node.js automatically retries the rejected promise after 1 second","The error is silently ignored and suppressed","The process emits unhandledRejection and terminates with a non-zero exit code by default","The process freezes indefinitely"],"question":"What happens if a Promise rejection is not handled by a .catch() handler in modern Node.js (v16+)?"}],"resources":[{"description":"Complete reference for Node.js standard runtime modules.","name":"Node.js Official Documentation","url":"https://nodejs.org/docs/latest/api/"},{"description":"Foundational architecture and server-side JavaScript guide.","name":"MDN Server-Side JavaScript","url":"https://developer.mozilla.org/en-US/docs/Learn/Server-side/Express_Nodejs"},{"description":"Deep dive into libuv, microtasks, and timer phases.","name":"Node.js Event Loop Visualizer Guide","url":"https://nodejs.org/en/learn/asynchronous-work/event-loop-timers-and-nexttick"}],"syllabus":[{"code_snippet":"// Demonstration of Event Loop Phase Priority\nconst fs = require('fs');\n\nconsole.log('1. Synchronous start');\n\nsetTimeout(() => console.log('2. setTimeout (Timer Phase)'), 0);\nsetImmediate(() => console.log('3. setImmediate (Check Phase)'));\nprocess.nextTick(() => console.log('4. process.nextTick (Microtask - Highest Priority)'));\nPromise.resolve().then(() => console.log('5. Promise.then (Microtask)'));\n\nfs.readFile(__filename, () => {\n  console.log('6. fs.readFile callback (I/O Poll Phase)');\n  setImmediate(() => console.log('7. setImmediate inside I/O callback runs before setTimeout'));\n  setTimeout(() => console.log('8. setTimeout inside I/O callback'), 0);\n});\n\nconsole.log('9. Synchronous end');","deep_dive":"Node.js runs single-threaded JavaScript code on top of libuv, which delegates asynchronous operations (file system, DNS, crypto) to a background thread pool. Timers execute in the Timers phase, while I/O callbacks run in the Poll phase.","key_concepts":["Call Stack & Task Queues","process.nextTick vs setImmediate","Microtasks vs Macrotasks","Thread Pool (libuv)"],"module_title":"Module 1: The Event Loop & Asynchronous Runtime"},{"code_snippet":"// Memory-Efficient Stream Pipeline with Error Handling\nconst fs = require('fs');\nconst zlib = require('zlib');\nconst { pipeline } = require('stream/promises');\n\nasync function compressLogFile(sourcePath, destPath) {\n  try {\n    const readStream = fs.createReadStream(sourcePath);\n    const gzipStream = zlib.createGzip();\n    const writeStream = fs.createWriteStream(destPath);\n\n    // pipeline handles backpressure, closes descriptors & cleans up on error\n    await pipeline(readStream, gzipStream, writeStream);\n    console.log(`Successfully compressed ${sourcePath} -> ${destPath}`);\n  } catch (err) {\n    console.error('Compression pipeline failed:', err.message);\n    throw err;\n  }\n}","deep_dive":"Buffering large files in memory with fs.readFile causes memory spikes and process crashes. Streams process data chunk-by-chunk in buffers, providing constant low memory overhead regardless of file size.","key_concepts":["Readable & Writable Streams","Transform Streams","Stream Pipelining","Handling Backpressure"],"module_title":"Module 2: Streams & Buffer Memory Management"},{"code_snippet":"// Decoupled Order Processing Event Emitter\nconst EventEmitter = require('events');\n\nclass OrderProcessor extends EventEmitter {\n  processOrder(order) {\n    console.log(`Processing order #${order.id}...`);\n    this.emit('order:created', order);\n    \n    // Simulate payment verification\n    setTimeout(() => {\n      this.emit('order:paid', { orderId: order.id, amount: order.total });\n    }, 100);\n  }\n}\n\nconst processor = new OrderProcessor();\nprocessor.on('order:created', (order) => console.log('Emailing receipt to:', order.email));\nprocessor.on('order:paid', (data) => console.log('Updating inventory for order:', data.orderId));\n\nprocessor.processOrder({ id: 'ORD-991', total: 149.99, email: 'candidate@careersense.ai' });","deep_dive":"Node.js core modules inherit from EventEmitter. Emitting events decouples producers from consumers, enabling event-driven architecture, modular logging, and decoupling business workflows.","key_concepts":["Observer Pattern","Custom EventEmitter Classes","Memory Leak Warnings","Once vs On Listeners"],"module_title":"Module 3: EventEmitter & Custom Event Architecture"},{"code_snippet":"// Multi-Process Node.js Cluster Scaffold\nconst cluster = require('cluster');\nconst http = require('http');\nconst os = require('os');\n\nconst numCPUs = os.cpus().length;\n\nif (cluster.isPrimary) {\n  console.log(`Primary master ${process.pid} is orchestrating ${numCPUs} workers...`);\n  for (let i = 0; i < numCPUs; i++) cluster.fork();\n\n  cluster.on('exit', (worker, code, signal) => {\n    console.warn(`Worker ${worker.process.pid} died. Spawning replacement...`);\n    cluster.fork();\n  });\n} else {\n  http.createServer((req, res) => {\n    res.writeHead(200, { 'Content-Type': 'application/json' });\n    res.end(JSON.stringify({ status: 'ok', workerPid: process.pid }));\n  }).listen(8000);\n}","deep_dive":"Because Node.js runs on a single main thread, a single process cannot utilize multiple CPU cores. The cluster module forks worker processes that share the same server port through IPC socket handoff.","key_concepts":["Cluster Module","Worker Threads vs Process Forking","Zero-Downtime Reloads","Process Managers (PM2)"],"module_title":"Module 4: Clustering & Multi-Core Scaling"}],"title":"Node.js Asynchronous Runtime & Backend Engineering","topics":["V8 Engine & Non-Blocking Event Loop Architecture","Node.js Core Modules (fs, path, events, streams)","Asynchronous Flow Control & Error Boundaries","Process Clustering, Streams & Production Memory Tuning"]},"duration_weeks":"Week 3 (Sprint)","expected_outcome":"Mastery of server-side JavaScript programming, event-driven architecture, and scalable microservice design.","id":567,"order_index":5,"phase_number":5,"practice_project":"High-Throughput Streaming File Transformer Microservice with Worker Clustering & Graceful Shutdown","priority":"HIGH","progress":0,"resource_categories":[{"description":"Complete reference for Node.js standard runtime modules.","name":"Node.js Official Documentation","url":"https://nodejs.org/docs/latest/api/"},{"description":"Foundational architecture and server-side JavaScript guide.","name":"MDN Server-Side JavaScript","url":"https://developer.mozilla.org/en-US/docs/Learn/Server-side/Express_Nodejs"},{"description":"Deep dive into libuv, microtasks, and timer phases.","name":"Node.js Event Loop Visualizer Guide","url":"https://nodejs.org/en/learn/asynchronous-work/event-loop-timers-and-nexttick"}],"roadmap_id":37,"skill_name":"Node.js","status":"Not Started","tasks":[{"allocated_hours":1.0,"day":1,"description":"Study core architecture, terminology, and foundational concepts of Node.js.","is_completed":false,"status":"Not Started","task_title":"Core Fundamentals & Concept Overview","title":"Day 1: Core Fundamentals & Concept Overview","week":3},{"allocated_hours":1.0,"day":2,"description":"Configure local development environment, tooling, and run first working Node.js example.","is_completed":false,"status":"Not Started","task_title":"Environment Setup & Hello-World","title":"Day 2: Environment Setup & Hello-World","week":3},{"allocated_hours":1.0,"day":3,"description":"Practice key syntax patterns, methods, and configurations in Node.js.","is_completed":false,"status":"Not Started","task_title":"Syntax & Essential APIs","title":"Day 3: Syntax & Essential APIs","week":3},{"allocated_hours":1.0,"day":4,"description":"Complete guided coding exercises implementing V8 Engine & Non-Blocking Event Loop Architecture.","is_completed":false,"status":"Not Started","task_title":"Hands-on Coding Exercises","title":"Day 4: Hands-on Coding Exercises","week":3},{"allocated_hours":1.0,"day":5,"description":"Connect Node.js with an external library or data source and test functionality.","is_completed":false,"status":"Not Started","task_title":"Mini Integration Lab","title":"Day 5: Mini Integration Lab","week":3}],"title":"Phase 5: Node.js Asynchronous Runtime & Backend Engineering","topics":["V8 Engine & Non-Blocking Event Loop Architecture","Node.js Core Modules (fs, path, events, streams)","Asynchronous Flow Control & Error Boundaries","Process Clustering, Streams & Production Memory Tuning"]},{"curriculum":{"exercises":[{"scenario":"Define the minimal inbound security group rules for an EC2 web server running NGINX with SSH access restricted to your admin IP address (203.0.113.4).","solution":"# Inbound Rules:\n# HTTP  | TCP | 80  | 0.0.0.0/0 (Anywhere IPv4)\n# HTTPS | TCP | 443 | 0.0.0.0/0 (Anywhere IPv4)\n# SSH   | TCP | 22  | 203.0.113.4/32 (Admin Specific IP Only)","starter_code":"# Inbound Rules:\n# Type | Protocol | Port Range | Source\n# ---------------------------