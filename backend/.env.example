PORT=5000
FLASK_ENV=development

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=careersense_ai

# SQLAlchemy Database URI (PyMySQL driver)
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/careersense_ai

# Application & Authentication Security
UPLOAD_FOLDER=uploads
SECRET_KEY=careersense_ai_secret_key_change_in_production
JWT_SECRET_KEY=careersense_ai_jwt_secret_change_in_production

# SMTP Email Configuration (For Email OTP Password Resets)
# For Gmail, generate an App Password from your Google Account:
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_DEFAULT_SENDER="CareerSense AI <noreply@careersense.ai>"

# Razorpay Payment Gateway (Test Mode / Sandbox)
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret

